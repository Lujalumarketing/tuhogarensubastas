{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/llamada",
      "destination": "https://calendar.app.google/31kqq7mstaSRPbfR7",
      "permanent": false
    },
    {
      "source": "/regalo",
      "destination": "https://drive.google.com/file/d/1S0l1Y-zwU6H6oRiMGc-qm4H0Ck6wTWrF/view?usp=sharing",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
